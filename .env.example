# Copy to .env and fill in for local runs.
# In CI these are stored as GitHub Actions secrets.

# OpenRouter — used for curation, script generation, and (optionally) TTS.
OPENROUTER_API_KEY=
# Optional script-generation model override.
# Comma-separated fallback list.
# Default: anthropic/claude-sonnet-4.6, openai/gpt-4o-mini, google/gemini-3.1-pro-preview.
# openai/... entries use OPENAI_API_KEY directly when available; other provider paths use OpenRouter.
OPENROUTER_SCRIPT_MODEL=
# Optional. Milliseconds for script generation (JSON schema). Keep between 60000 and 900000.
OPENROUTER_SCRIPT_TIMEOUT_MS=360000

# OpenAI — used directly for default script generation and text-to-speech.
OPENAI_API_KEY=

# Public base URL where docs/ is served. Used to build enclosure URLs in feed.xml.
# Replace USER with your GitHub username.
FEED_BASE_URL=https://USER.github.io/ai-briefing

# Apple Podcasts metadata for feed.xml.
PODCAST_AUTHOR=AI Briefing
PODCAST_SUMMARY=Daily AI news briefing — the stories that matter from the last 24 hours, fully scripted.
PODCAST_OWNER_NAME=AI Briefing
PODCAST_OWNER_EMAIL=noreply@example.com
PODCAST_HOST_NAME=AI Briefing
# "yes" discourages unauthorized imports into other podcast hosts. Set to "no" before intentionally migrating.
PODCAST_LOCKED=yes
# Place your square artwork file at docs/podcast-cover.jpg (1400x1400 to 3000x3000 recommended).
PODCAST_IMAGE_URL=https://USER.github.io/ai-briefing/podcast-cover.jpg
# Comma-separated iTunes categories.
PODCAST_CATEGORIES=Technology
# "true" or "false"
PODCAST_EXPLICIT=false
# "episodic" or "serial"
PODCAST_TYPE=episodic

# TTS provider: "openai" (default, OPENAI_API_KEY) or "openrouter" (OPENROUTER_API_KEY).
# OpenRouter routes to expressive third-party TTS models (Gemini TTS, MAI Voice, ...)
# via its OpenAI-compatible /audio/speech endpoint.
TTS_PROVIDER=openai

# TTS model, interpreted per provider.
# openai:     tts-1, tts-1-hd, gpt-4o-mini-tts (default; supports delivery instructions).
# openrouter: any OpenRouter text->speech model id.
#             Default: google/gemini-3.1-flash-tts-preview (supports inline delivery
#             tags like [chuckles] that the script writer uses sparingly).
TTS_MODEL=gpt-4o-mini-tts

# TTS voice for the single host, interpreted per provider.
# openai voices: alloy, ash, ballad, cedar, coral, echo, fable, marin, nova, onyx, sage, shimmer, verse.
#   Defaults to marin when unset; cedar, sage, and verse are natural-sounding alternates.
# openrouter voices are model-specific (Gemini TTS: Charon (default), Puck, Kore, Enceladus, ...).
# The voice ID controls timbre (how the voice *sounds*) and is the only lever for that.
# Compare candidates by ear with: npm run tts:sample
TTS_VOICE=

# TTS delivery instructions (OpenAI gpt-4o-mini-tts only; OpenRouter models rely on
# inline delivery tags instead). Voice ID controls timbre; these control performance.
TTS_GLOBAL_STYLE=
TTS_NARRATOR_STYLE=
TTS_INTRO_STYLE=
TTS_STORY_STYLE=
TTS_OUTRO_STYLE=

# Per-segment OpenAI TTS timeout in milliseconds. Keep between 60000 and 600000.
TTS_TIMEOUT_MS=180000

# Audio cues/stingers between sections ("true" by default).
# Set to "false" to disable synthetic intro/transition/outro cues.
AUDIO_CUES_ENABLED=true

# Cue style: tone, chime, tick (synthesized), or asset (committed music files from
# assets/audio/cue-{intro,transition,outro}.{mp3,wav}; falls back to tone when missing).
# Generate music assets once with: npm run stingers:generate
AUDIO_CUE_STYLE=tone
